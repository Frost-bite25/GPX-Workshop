{
  "name": "GPX Workshop",
  "short_name": "GPX Workshop",
  "description": "Edit, store and share GPX tracks for off-road riding.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0a0b0a",
  "theme_color": "#0a0b0a",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "files": [ { "name": "gpx", "accept": [".gpx", ".zip", "application/gpx+xml", "application/zip", "application/xml", "text/xml", "application/octet-stream"] } ] }
  },
  "file_handlers": [ { "action": "./", "accept": { "application/gpx+xml": [".gpx"] } } ]
}
